{
  "name": "next-fighting-game",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D pixel-art 1v1 parry dueling game with a shared lobby, ranked matchmaking and a roster of weapon-based characters.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "node scripts/build-artifact.mjs",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:crazygames": "node scripts/build-crazygames.mjs",
    "render:voxel": "node tools/voxel/render-sheet.mjs",
    "export:voxel": "node tools/voxel/export-vox.mjs",
    "render:portraits": "node tools/voxel/render-portraits.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^3.2.7"
  }
}
